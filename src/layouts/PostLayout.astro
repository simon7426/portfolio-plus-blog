---
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareLinks from '../components/ShareLinks.astro';

interface Heading {
  depth: number;
  text: string;
  slug: string;
}

interface PostNav {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
  prevPost?: PostNav;
  nextPost?: PostNav;
  headings?: Heading[];
  slug?: string;
}

const { title, description, date, updatedDate, tags, readingTime, prevPost, nextPost, headings = [], slug } = Astro.props;
---

<BaseLayout title={title} description={description} slug={slug}>
  <div class="progress-bar" id="progress-bar"></div>
  <div class="post-layout">
    <article class="post-content-wrapper" id="post-article">
      <header class="post-header">
        <div class="post-header__top">
          <ThemeToggle />
        </div>
        <h1 class="post-header__title">{title}</h1>
        <div class="post-header__meta">
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {updatedDate && (
            <>
              <span class="separator">&middot;</span>
              <span>Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
            </>
          )}
          <span class="separator">&middot;</span>
          <span>{readingTime} min read</span>
        </div>
        {tags.length > 0 && (
          <ul class="post-header__tags">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}`}>{tag}</a>
              </li>
            ))}
          </ul>
        )}
      </header>

      <div class="post-content">
        <slot />
      </div>

      <ShareLinks title={title} url={Astro.url.href} />

      {(prevPost || nextPost) && (
        <nav class="post-nav">
          {prevPost ? (
            <a href={`/writing/${prevPost.slug}`} class="post-nav__link post-nav__link--prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <div>
                <span class="post-nav__label">Previous</span>
                <span class="post-nav__title">{prevPost.title}</span>
              </div>
            </a>
          ) : (
            <div />
          )}
          {nextPost ? (
            <a href={`/writing/${nextPost.slug}`} class="post-nav__link post-nav__link--next">
              <div>
                <span class="post-nav__label">Next</span>
                <span class="post-nav__title">{nextPost.title}</span>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )}
    </article>

    <aside class="post-sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .post-layout {
    max-width: 110ch;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 3rem;
  }

  .post-content-wrapper {
    min-width: 0;
  }

  .post-header {
    margin-bottom: 1rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header__top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .post-header__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .post-header__meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .separator {
    color: var(--border-strong);
  }

  .post-header__tags {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .post-header__tags a {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    text-decoration: none;
    color: var(--text-secondary);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    text-transform: lowercase;
    background: var(--tag-bg);
  }

  .post-header__tags a:hover {
    border-color: var(--border-strong);
    text-decoration: none;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-nav__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-secondary);
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .post-nav__link:hover {
    border-color: var(--border-strong);
    color: var(--text);
    text-decoration: none;
  }

  .post-nav__link--prev {
    justify-content: flex-start;
  }

  .post-nav__link--next {
    justify-content: flex-end;
    text-align: right;
  }

  .post-nav__label {
    display: block;
    font-size: 0.7rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .post-nav__title {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
      max-width: 65ch;
    }

    .post-sidebar {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
  }

  .code-block__lang {
    position: absolute;
    top: 0.5rem;
    left: 0.75rem;
    font-size: 0.65rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    pointer-events: none;
  }

  .code-block:has(.code-block__lang) pre {
    padding-top: 2rem;
  }

  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--text);
    z-index: 1000;
    transition: width 0.1s linear;
  }
</style>

<script>
  (function() {
    if (typeof document === 'undefined') return;

    function initCopyButtons() {
    const blocks = document.querySelectorAll('.post-content pre');

    blocks.forEach((pre) => {
      if (pre.closest('.code-block')) return;
      if (pre.getAttribute('data-language') === 'mermaid') return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.parentNode!.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const lang = pre.getAttribute('data-language') || '';
      if (lang && lang !== 'text' && lang !== 'plaintext') {
        const label = document.createElement('span');
        label.className = 'code-block__lang';
        label.textContent = lang.charAt(0).toUpperCase() + lang.slice(1);
        wrapper.appendChild(label);
      }

      const button = document.createElement('button');
      button.className = 'code-block__copy';
      button.setAttribute('aria-label', 'Copy code');
      button.innerHTML = `
        <svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      `;

      wrapper.appendChild(button);

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code') || pre;
        const text = code.textContent;

        try {
          await navigator.clipboard.writeText(text);
          button.classList.add('code-block__copy--copied');
          (button.querySelector('.icon-copy') as HTMLElement).style.display = 'none';
          (button.querySelector('.icon-check') as HTMLElement).style.display = 'block';

          setTimeout(() => {
            button.classList.remove('code-block__copy--copied');
            (button.querySelector('.icon-copy') as HTMLElement).style.display = 'block';
            (button.querySelector('.icon-check') as HTMLElement).style.display = 'none';
          }, 2000);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);

          button.classList.add('code-block__copy--copied');
          (button.querySelector('.icon-copy') as HTMLElement).style.display = 'none';
          (button.querySelector('.icon-check') as HTMLElement).style.display = 'block';

          setTimeout(() => {
            button.classList.remove('code-block__copy--copied');
            (button.querySelector('.icon-copy') as HTMLElement).style.display = 'block';
            (button.querySelector('.icon-check') as HTMLElement).style.display = 'none';
          }, 2000);
        }
      });
    });
  }

  async function initMermaid() {
    const mermaidBlocks = document.querySelectorAll('.post-content pre[data-language="mermaid"]');
    if (mermaidBlocks.length === 0) return;

    const { default: mermaid } = await import('mermaid');

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark'
      || (!document.documentElement.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'loose',
    });

    for (const pre of mermaidBlocks) {
      const codeEl = pre.querySelector('code');
      const definition = codeEl?.textContent || pre.textContent;
      const container = document.createElement('div');
      container.className = 'mermaid';
      container.textContent = definition;

      try {
        const { svg } = await mermaid.render(`mermaid-${crypto.randomUUID()}`, definition);
        container.innerHTML = svg;
      } catch {
        container.textContent = 'Failed to render diagram';
      }

      pre.replaceWith(container);
    }
  }

  function initProgressBar() {
    const bar = document.getElementById('progress-bar');
    const article = document.getElementById('post-article');
    if (!bar || !article) return;

    function update() {
      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = article.offsetHeight;
      const viewportHeight = window.innerHeight;
      const scrolled = window.scrollY - articleTop;
      const total = articleHeight - viewportHeight;
      const progress = Math.min(Math.max(scrolled / total, 0), 1);
      bar.style.width = `${progress * 100}%`;
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.addEventListener('astro:after-swap', () => {
    initCopyButtons();
    initMermaid();
    initProgressBar();
  });

  initCopyButtons();
  initMermaid();
  initProgressBar();
  })();
</script>
