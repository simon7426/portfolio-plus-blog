---
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
}

const { title, description, date, updatedDate, tags, readingTime } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container container--wide">
    <header class="post-header">
      <div class="post-header__top">
        <ThemeToggle />
      </div>
      <h1 class="post-header__title">{title}</h1>
      <div class="post-header__meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {updatedDate && (
          <>
            <span class="separator">&middot;</span>
            <span>Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
          </>
        )}
        <span class="separator">&middot;</span>
        <span>{readingTime} min read</span>
      </div>
      {tags.length > 0 && (
        <ul class="post-header__tags">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}`}>{tag}</a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="post-content">
      <slot />
    </div>

    <NewsletterSignup />
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 1rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header__top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .post-header__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .post-header__meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .separator {
    color: var(--border-strong);
  }

  .post-header__tags {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .post-header__tags a {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    text-decoration: none;
    color: var(--text-secondary);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    text-transform: lowercase;
    background: var(--tag-bg);
  }

  .post-header__tags a:hover {
    border-color: var(--border-strong);
    text-decoration: none;
  }
</style>

<script>
  function initCopyButtons() {
    const blocks = document.querySelectorAll('.post-content pre');

    blocks.forEach((pre) => {
      if (pre.closest('.code-block')) return;
      if (pre.getAttribute('data-language') === 'mermaid') return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.className = 'code-block__copy';
      button.setAttribute('aria-label', 'Copy code');
      button.innerHTML = `
        <svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      `;

      wrapper.appendChild(button);

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code') || pre;
        const text = code.textContent;

        try {
          await navigator.clipboard.writeText(text);
          button.classList.add('code-block__copy--copied');
          button.querySelector('.icon-copy').style.display = 'none';
          button.querySelector('.icon-check').style.display = 'block';

          setTimeout(() => {
            button.classList.remove('code-block__copy--copied');
            button.querySelector('.icon-copy').style.display = 'block';
            button.querySelector('.icon-check').style.display = 'none';
          }, 2000);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);

          button.classList.add('code-block__copy--copied');
          button.querySelector('.icon-copy').style.display = 'none';
          button.querySelector('.icon-check').style.display = 'block';

          setTimeout(() => {
            button.classList.remove('code-block__copy--copied');
            button.querySelector('.icon-copy').style.display = 'block';
            button.querySelector('.icon-check').style.display = 'none';
          }, 2000);
        }
      });
    });
  }

  async function initMermaid() {
    const mermaidBlocks = document.querySelectorAll('.post-content pre[data-language="mermaid"]');
    if (mermaidBlocks.length === 0) return;

    const { default: mermaid } = await import('mermaid');

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark'
      || (!document.documentElement.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'loose',
    });

    for (const pre of mermaidBlocks) {
      const codeEl = pre.querySelector('code');
      const definition = codeEl?.textContent || pre.textContent;
      const container = document.createElement('div');
      container.className = 'mermaid';
      container.textContent = definition;

      try {
        const { svg } = await mermaid.render(`mermaid-${crypto.randomUUID()}`, definition);
        container.innerHTML = svg;
      } catch {
        container.textContent = 'Failed to render diagram';
      }

      pre.replaceWith(container);
    }
  }

  document.addEventListener('astro:after-swap', () => {
    initCopyButtons();
    initMermaid();
  });

  initCopyButtons();
  initMermaid();
</script>
