---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';

const games = [
  {
    href: '/play/snake',
    title: 'Snake',
    description: 'The classic. Eat, grow, don\'t hit yourself.',
  },
  {
    href: '/play/sudoku',
    title: 'Sudoku',
    description: '6×6 or 9×9. Easy, medium, or hard.',
  },
];
---

<BaseLayout title="Play">
  <div class="container">
    <div class="page-top">
      <ThemeToggle />
    </div>
    <h1 class="page-title">Play</h1>
    <p class="page-subtitle">Take a break. These run entirely in your browser.</p>

    <ul class="games-list">
      {games.map((game) => (
        <li>
          <a href={game.href} class="game-card">
            <span class="game-card__title">{game.title}</span>
            <span class="game-card__desc">{game.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    font-size: 1rem;
  }

  .games-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .game-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .game-card:hover {
    border-color: var(--border-strong);
    background: var(--bg-secondary);
    text-decoration: none;
  }

  .game-card__title {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .game-card__desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }
</style>
