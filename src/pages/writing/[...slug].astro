---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  const publishedPosts = posts.filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return publishedPosts.map((post, index) => {
    const prevPost = index > 0 ? { slug: publishedPosts[index - 1].slug, title: publishedPosts[index - 1].data.title } : undefined;
    const nextPost = index < publishedPosts.length - 1 ? { slug: publishedPosts[index + 1].slug, title: publishedPosts[index + 1].data.title } : undefined;

    return {
      params: { slug: post.slug },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { data, body } = post;
const { Content, headings: rawHeadings } = await post.render();
const readingTime = getReadingTime(body);

const headings = (rawHeadings || [])
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({
    depth: h.depth - 1,
    text: h.text,
    slug: h.slug,
  }));
---

<PostLayout
  title={data.title}
  description={data.description}
  date={data.date}
  updatedDate={data.updatedDate}
  tags={data.tags}
  readingTime={readingTime}
  prevPost={prevPost}
  nextPost={nextPost}
  headings={headings}
  slug={post.slug}
>
  <Content />
</PostLayout>
