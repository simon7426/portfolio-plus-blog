---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  const tags = new Set<string>();

  posts
    .filter((post) => !post.data.draft)
    .forEach((post) => {
      post.data.tags.forEach((tag) => tags.add(tag));
    });

  return Array.from(tags).map((tag) => {
    const taggedPosts = posts
      .filter((post) => !post.data.draft && post.data.tags.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { tag, posts: taggedPosts },
    };
  });
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged with "${tag}".`}>
  <div class="container">
    <div class="tag">
      <div class="tag__top">
        <ThemeToggle />
      </div>
      <h1 class="tag__title">Tag: {tag}</h1>
      <p class="tag__count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>

      {posts.length > 0 ? (
        posts.map((post) => (
          <PostCard post={post} />
        ))
      ) : (
        <p class="tag__empty">No posts with this tag.</p>
      )}

      <div class="tag__footer">
        <a href="/writing" class="tag__back">&larr; Back to all writing</a>
        <a href={`/tags/${tag}/rss.xml`} class="tag__rss" aria-label={`RSS for ${tag}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 0 4.36 2.18 2.18 0 0 1 0-4.36M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
          </svg>
          RSS for this tag
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tag {
    padding: 1rem 0;
  }

  .tag__top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 2rem;
  }

  .tag__title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .tag__count {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    margin-bottom: 2rem;
  }

  .tag__empty {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.95rem;
  }

  .tag__back {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.85rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .tag__back:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .tag__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tag__rss {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .tag__rss:hover {
    color: var(--text);
    text-decoration: none;
  }
</style>
