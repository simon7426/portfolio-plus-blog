---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../utils/reading-time';

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { data, slug, body } = post;
const readingTime = getReadingTime(body);
---

<article class="post-card">
  <a href={`/writing/${slug}`} class="post-card__link">
    <h2 class="post-card__title">{data.title}</h2>
  </a>
  {data.description && (
    <p class="post-card__description">{data.description}</p>
  )}
  <div class="post-card__meta">
    <time datetime={data.date.toISOString()}>
      {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <span>{readingTime} min read</span>
  </div>
  {data.tags.length > 0 && (
    <ul class="post-card__tags">
      {data.tags.map((tag) => (
        <li>
          <a href={`/tags/${tag}`}>{tag}</a>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-card:first-child {
    padding-top: 0;
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-card__link {
    text-decoration: none;
  }

  .post-card__link:hover {
    text-decoration: none;
  }

  .post-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .post-card__description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    line-height: 1.55;
  }

  .post-card__meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .post-card__tags {
    list-style: none;
    display: flex;
    gap: 0.4rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  .post-card__tags a {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    text-decoration: none;
    color: var(--text-secondary);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    text-transform: lowercase;
    background: var(--tag-bg);
  }

  .post-card__tags a:hover {
    border-color: var(--border-strong);
    text-decoration: none;
  }
</style>
