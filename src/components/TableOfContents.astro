---
interface Heading {
  depth: number;
  text: string;
  slug: string;
}

interface TreeNode extends Heading {
  children: TreeNode[];
}

interface Props {
  headings: Heading[];
}

function buildTree(headings: Heading[]): TreeNode[] {
  const root: TreeNode[] = [];
  const stack: TreeNode[] = [];

  for (const h of headings) {
    const node: TreeNode = { ...h, children: [] };

    while (stack.length > 0 && stack[stack.length - 1].depth >= node.depth) {
      stack.pop();
    }

    if (stack.length === 0) {
      root.push(node);
    } else {
      stack[stack.length - 1].children.push(node);
    }

    stack.push(node);
  }

  return root;
}

function renderNodes(nodes: TreeNode[]): string {
  if (nodes.length === 0) return '';

  return '<ul class="toc__list">' + nodes.map((node) => {
    const childrenHtml = renderNodes(node.children);
    return `<li class="toc__item"><a href="#${node.slug}">${node.text}</a>${childrenHtml}</li>`;
  }).join('') + '</ul>';
}

const { headings } = Astro.props;
const tree = buildTree(headings);
---

{headings.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <h2 class="toc__title">On this page</h2>
    <Fragment set:html={renderNodes(tree)} />
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding: 1.25rem 0 1.25rem 1.25rem;
    border-left: 1px solid var(--border);
  }

  .toc__title {
    font-size: 0.7rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc__item {
    margin-bottom: 0.4rem;
  }

  .toc__item a {
    font-size: 0.78rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.4;
    display: block;
    transition: color 0.15s ease;
  }

  .toc__item a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .toc__item a.active {
    color: var(--text);
    font-weight: 500;
  }

  .toc__list .toc__list {
    margin-top: 0.4rem;
    padding-left: 0.85rem;
    border-left: 1px solid var(--border);
  }

  .toc__list .toc__list .toc__item a {
    font-size: 0.72rem;
  }

  @media (max-width: 900px) {
    .toc {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:after-swap', initTocObserver);
  initTocObserver();

  function initTocObserver() {
    const links = document.querySelectorAll('.toc__item a');
    if (links.length === 0) return;

    const headingEls: Element[] = [];
    links.forEach((link) => {
      const id = link.getAttribute('href')?.slice(1);
      if (id) {
        const heading = document.getElementById(id);
        if (heading) headingEls.push(heading);
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          const link = document.querySelector(`.toc__item a[href="#${id}"]`);
          if (link) {
            if (entry.isIntersecting) {
              links.forEach((l) => l.classList.remove('active'));
              link.classList.add('active');
            }
          }
        });
      },
      { rootMargin: '0px 0px -80% 0px', threshold: 0 }
    );

    headingEls.forEach((h) => observer.observe(h));
  }
</script>
