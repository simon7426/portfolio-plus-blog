---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/writing', label: 'Writing' },
  { href: '/resume', label: 'Resume' },
  { href: '/play', label: 'Play' },
];
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="nav__logo">Simon Islam</a>
      <button class="nav__menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <ul class="nav__links">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav__link',
                { 'nav__link--active': Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href)) }
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    padding: 1.75rem 0 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav__logo {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav__logo:hover {
    text-decoration: none;
  }

  .nav__menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    color: var(--text-secondary);
  }

  .nav__menu-toggle:hover {
    color: var(--text);
  }

  .nav__menu-toggle .icon-close {
    display: none;
  }

  .nav__menu-toggle[aria-expanded="true"] .icon-menu {
    display: none;
  }

  .nav__menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  .nav__links {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .nav__link {
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--text-secondary);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    transition: color 0.15s ease;
  }

  .nav__link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav__link--active {
    color: var(--text);
  }

  @media (max-width: 600px) {
    .header {
      margin-bottom: 2rem;
    }

    .nav__menu-toggle {
      display: block;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.5rem;
      gap: 0.75rem;
      align-items: flex-start;
      z-index: 100;
    }

    .nav__links--open {
      display: flex;
    }

    .nav {
      position: relative;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav__menu-toggle');
  const links = document.querySelector('.nav__links');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    links?.classList.toggle('nav__links--open');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!toggle?.contains(target) && !links?.contains(target)) {
      toggle?.setAttribute('aria-expanded', 'false');
      links?.classList.remove('nav__links--open');
    }
  });

  links?.querySelectorAll('.nav__link').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      links.classList.remove('nav__links--open');
    });
  });
</script>
